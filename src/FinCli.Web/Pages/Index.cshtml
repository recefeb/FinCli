@page
@model IndexModel
@{
	ViewData["Title"] = "Home page";
}

<h1 class="visually-hidden">FinCli</h1>

<div class="fc-banner mb-4">
	<pre class="fc-banner-art" aria-hidden="true">███████╗██╗███╗   ██╗ ██████╗██╗     ██╗
██╔════╝██║████╗  ██║██╔════╝██║     ██║
█████╗  ██║██╔██╗ ██║██║     ██║     ██║
██╔══╝  ██║██║╚██╗██║██║     ██║     ██║
██║     ██║██║ ╚████║╚██████╗███████╗██║
╚═╝     ╚═╝╚═╝  ╚═══╝ ╚═════╝╚══════╝╚═╝</pre>
	<p class="fc-banner-tagline">Personal Finance Tracker</p>
	<p class="fc-banner-total">Total spent: @Model.Total.ToString("C2")</p>
</div>

@if (Model.CategoryTotals.Count > 0)
{
	<h2 class="h4 mt-4">Spending by category</h2>

	@foreach (var entry in Model.CategoryTotals.OrderByDescending(e => e.Value))
	{
		var percent = (double)(entry.Value / Model.Total) * 100;

		<div class="mb-3">
			<div class="d-flex justify-content-between">
				<span>@entry.Key</span>
				<span>@entry.Value.ToString("C2") (@(percent.ToString("0"))%)</span>
			</div>
			<div class="progress">
				<div class="progress-bar" role="progressbar"
					 style="width: @(percent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
			</div>
		</div>
	}

	<div class="mx-auto mt-4" style="max-width: 360px;">
		<canvas id="categoryChart"></canvas>
	</div>
}

@section Scripts {
	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	<script>
		const canvas = document.getElementById('categoryChart');

		if (canvas) {
			const labels = @Json.Serialize(Model.CategoryTotals.OrderByDescending(e => e.Value).Select(e => e.Key));
			const values = @Json.Serialize(Model.CategoryTotals.OrderByDescending(e => e.Value).Select(e => e.Value));

			const textColor = () => getComputedStyle(document.body).color;

			const chart = new Chart(canvas, {
				type: 'doughnut',
				data: {
					datasets: [{
						data: values,
						backgroundColor: ['#e0a646', '#93b47c', '#c8604f', '#8f897d', '#d4c19a', '#6f8f9a'],
						borderWidth: 0
					}]
				},
				options: {
					color: textColor()
				}
			});

			document.addEventListener('themechange', () => {
				chart.options.color = textColor();
				chart.update();
			});
		}
	</script>
}